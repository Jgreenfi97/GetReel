# ─────────────────────────────────────────────────────────────
#  GetReel configuration
#  Copy this file to `.env.local` and fill in the keys you have.
#  Every key is optional: anything missing falls back to demo data.
# ─────────────────────────────────────────────────────────────

# Claude works out which movie someone is describing.
# Get a key at https://platform.claude.com/settings/keys (pay as you go).
ANTHROPIC_API_KEY=

# Optional: which Claude model to use and how hard it should think.
# Defaults: claude-opus-5-5 at "medium" effort. Effort can be low | medium | high | xhigh | max.
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# TMDB supplies posters, cast, trailers and "where to watch" (free for non-commercial use).
# Create an account at https://www.themoviedb.org, then Settings → API.
# Paste either the "API Read Access Token" (long, starts with eyJ…) or the shorter "API Key".
TMDB_API_KEY=

# Optional: lets GetReel search YouTube for the exact scene that was described,
# instead of only showing the official trailer. Free (≈100 searches per day).
# Google Cloud Console → enable "YouTube Data API v3" → Credentials → API key.
YOUTUBE_API_KEY=

# Optional: the country used for "where to watch" listings (two-letter code).
# WATCH_REGION=US

# Optional: searches allowed per visitor per hour (protects your Claude bill). Default 30.
# SEARCH_RATE_LIMIT_PER_HOUR=30

# Optional: set to 1 to force demo mode even when keys are present.
# GETREEL_DEMO=0

# Optional: how long demo searches pretend to think, in milliseconds, so the
# loading screen plays like a real search. Default 1400; 0 makes them instant.
# GETREEL_DEMO_DELAY_MS=1400
